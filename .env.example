# Shared Environment Configuration
# Copy this file to .env and fill in the values

# ============================================
# JWT Authentication (Shared Secret)
# ============================================
# IMPORTANT: This secret must be the same in both frontend and backend
# Generate a secure random key: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-minimum-32-characters-long

# ============================================
# Database (Neon PostgreSQL)
# ============================================
# Get your connection string from Neon Dashboard
DATABASE_URL=postgresql://username:password@ep-xxx.us-east-1.aws.neon.tech/DBNAME?sslmode=require

# ============================================
# Frontend Configuration
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_LOGGER=false

# ============================================
# Backend Configuration
# ============================================
JWT_ALGORITHM=HS256
JWT_EXPIRATION=7d
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
HOST=0.0.0.0
PORT=8000
DEBUG=false
